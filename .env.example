# =============================================================================
# Flask & Deployment Runtime Configuration
# =============================================================================
FLASK_DEBUG=false
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Reverse Proxy Security
# Set TRUSTED_PROXIES_COUNT to the exact number of upstream reverse proxy hops
# (e.g., 1 on Render/Heroku/AWS ALB, 1 behind local Nginx).
# Default 0 means direct connection (all X-Forwarded-* headers are ignored).
# SECURITY REQUIREMENT: Gunicorn must bind to 127.0.0.1 or a private Unix socket
# so it cannot be directly contacted by the public Internet bypassing the proxy.
TRUSTED_PROXIES_COUNT=0

# =============================================================================
# Firebase Admin SDK & Authentication Configuration
# =============================================================================
# In production, set REQUIRE_AUTH=true to enforce cryptographic Firebase ID token verification.
# Production initializes via Google Application Default Credentials (ADC).
# Provide GOOGLE_APPLICATION_CREDENTIALS pointing to an external JSON path, or rely on
# Cloud IAM Workload Identity if deployed on GCP/Cloud Run/GKE.
# NEVER commit service account credential files to git.
# FIREBASE_PROJECT_ID must match your Firebase project / token audience.
REQUIRE_AUTH=true
FIREBASE_PROJECT_ID=trendanalyzer-4857f
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# =============================================================================
# Admin Tools & Access Control
# =============================================================================
# Keep ENABLE_DB_VIEWER=false in production. If ever enabled, ADMIN_KEY must be >= 16 chars.
ENABLE_DB_VIEWER=false
ADMIN_KEY=set-a-strong-random-admin-secret-here

# CORS Configuration (exact-match comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# =============================================================================
# Rate Limiting & Concurrency Note
# =============================================================================
# Current sliding-window rate limiter is worker-process-local.
# In a multi-worker deployment (e.g. 4 Gunicorn workers), the effective aggregate
# limit across all workers is N * configured_limit per client IP.
# If horizontal scaling across multiple containers is needed in the future,
# deploy a shared Redis-backed limiter.
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_PREDICT=30
RATE_LIMIT_TRAIN=5
RATE_LIMIT_AUTH=30
